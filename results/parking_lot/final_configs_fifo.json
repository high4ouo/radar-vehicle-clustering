{
  "sensor": "RETINA-4FN B0 LRR Outdoor Normal CW 50 ms",
  "fit_dataset": "2026-08-25 vehicle GT plus user-identified static scene objects; FIFO temporal sweep on fixed radar coordinates",
  "feature_weights": {
    "doppler_m_per_mps": 0.4,
    "range_power_iqr_m": 0.25
  },
  "doppler_to_kmh": 3.6,
  "algorithms": {
    "HDBSCAN": {
      "density": {
        "hdbscan_cluster_selection_epsilon": 1.5,
        "hdbscan_min_cluster_size": 8,
        "hdbscan_min_samples_library": 4
      },
      "fifo_frames": 7,
      "merge": {
        "azimuth_resolution_deg": 4.0,
        "base_point_gap_m": 2.0,
        "doppler_max_abs_mps": 10.0,
        "doppler_min_abs_mps": 0.15,
        "max_azimuth_gap_deg": 10.0,
        "max_doppler_gap_mps": 2.5,
        "max_point_gap_m": 10.0,
        "max_range_gap_m": 15.0
      }
    },
    "R OPTICS": {
      "density": {
        "optics_max_eps": 6.0,
        "optics_min_samples": 7,
        "optics_xi": 0.02
      },
      "fifo_frames": 10,
      "merge": {
        "azimuth_resolution_deg": 4.0,
        "base_point_gap_m": 2.0,
        "doppler_max_abs_mps": 10.0,
        "doppler_min_abs_mps": 0.15,
        "max_azimuth_gap_deg": 10.0,
        "max_doppler_gap_mps": 2.5,
        "max_point_gap_m": 10.0,
        "max_range_gap_m": 15.0
      }
    },
    "RETINA-DBSCAN": {
      "density": {
        "eps_base_m": 1.25,
        "eps_knee_m": 40.0,
        "eps_max_m": 3.5,
        "eps_slope": 0.03,
        "min_samples_far": 3,
        "min_samples_near": 4,
        "nmin_transition_m": 90.0
      },
      "fifo_frames": 7,
      "merge": {
        "azimuth_resolution_deg": 4.0,
        "base_point_gap_m": 2.0,
        "doppler_max_abs_mps": 10.0,
        "doppler_min_abs_mps": 0.15,
        "max_azimuth_gap_deg": 10.0,
        "max_doppler_gap_mps": 2.5,
        "max_point_gap_m": 10.0,
        "max_range_gap_m": 15.0
      }
    }
  },
  "temporal_model": {
    "input_rate_hz": 20,
    "evaluated_fifo_frames": [
      1,
      3,
      5,
      7,
      10
    ],
    "publish_current_frame_only": true,
    "stable_cluster_ids": true
  }
}
